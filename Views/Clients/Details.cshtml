@model CloseReady.Models.Client

@{
    ViewData["Title"] = Model.Name;
    }

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-dark">
        ← Back to clients
    </a>
</div>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="fw-bold mb-1">@Model.Name</h2>
        <div class="text-muted">@Model.Email</div>
    </div>

    <a asp-controller="CollectionCycles" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-dark">
        New Cycle
    </a>
</div>

<h5 class="mb-3">Collection Cycles</h5>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="px-4 py-3">Cycle</th>
                    <th class="py-3">Due Date</th>
                    <th class="py-3">Status</th>
                </tr>
            </thead>

            <tbody>
                @if (ViewBag.CollectionCycles.Count == 0)
                    {
                    <tr>
                        <td class="px-4 py-3 text-muted" colspan="3">
                            No collection cycles yet.
                        </td>
                    </tr>
                    }
                else
                    {
                    foreach (var cycle in ViewBag.CollectionCycles)
                        {
                        <tr>
                            <td class="px-4 py-3">
                                <a asp-controller="CollectionCycles" asp-action="Details" asp-route-id="@cycle.Id" class="text-decoration-none text-dark fw-semibold">
                                    @cycle.Name
                                </a>
                            </td>

                            <td class="py-3">
                                @cycle.DueDate.ToString("M/d/yyyy")
                            </td>

                            <td class="py-3">
                                @cycle.Status
                            </td>
                        </tr>
                        }
                    }
            </tbody>
        </table>
    </div>
</div>