@model IEnumerable<CloseReady.Models.Client>

@{
    ViewData["Title"] = "Clients";
    }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Clients</h2>

    <a asp-action="Create" class="btn btn-dark">
        New Client
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="px-4 py-3">Name</th>
                    <th class="py-3">Email</th>
                    <th class="py-3">Added</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var client in Model)
                    {
                    <tr>
                        <td class="px-4 py-3">
                            <a asp-action="Details"
                               asp-route-id="@client.Id"
                               class="text-decoration-none text-dark fw-semibold">
                                @client.Name
                            </a>
                        </td>

                        <td class="py-3">
                            @client.Email
                        </td>

                        <td class="py-3 text-muted">
                            @client.CreatedAt.ToLocalTime().ToString("M/d/yyyy")
                        </td>
                    </tr>
                    }
            </tbody>
        </table>
    </div>
</div>